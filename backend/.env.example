# Скопируйте этот файл в .env и заполните значения (или экспортируйте переменные в терминале)

SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///handwriting.db

# Ключ Google Cloud Vision API - нужен для распознавания текста на загруженных фото.
# Как получить: см. README.md, раздел "Настройка OCR".
GOOGLE_VISION_API_KEY=

PORT=5000
